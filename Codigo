class NavegadorWeb:

    def __init__(self):
        self.pila_atras = []
        self.pila_adelante = []
        self.pagina_actual = "about:blank"
        self.CAPACIDAD_MAXIMA = 4

    def visitar(self, url):
        if len(self.pila_atras) >= self.CAPACIDAD_MAXIMA:
            print(f" PILA LLENADA [{self.CAPACIDAD_MAXIMA}]")
            print("Paginas visitadas:")
            for i, pagina in enumerate(self.pila_atras, start=1):
                print(str(i) + ". " + pagina)
            return

        self.pila_atras.append(self.pagina_actual)
        self.pagina_actual = url
        self.pila_adelante.clear()
        print("Visitando: " + self.pagina_actual)

    def back(self):
        if len(self.pila_atras) == 0:
            print("X PILA VACIA")
            return

        if len(self.pila_adelante) < self.CAPACIDAD_MAXIMA:
            self.pila_adelante.append(self.pagina_actual)

        self.pagina_actual = self.pila_atras.pop()
        print("regresaste a: " + self.pagina_actual)

    def forward(self):
        if len(self.pila_adelante) == 0:
            print("X PILA VACIA")
            return

        if len(self.pila_atras) < self.CAPACIDAD_MAXIMA:
            self.pila_atras.append(self.pagina_actual)

        self.pagina_actual = self.pila_adelante.pop()
        print("avanzaste a: " + self.pagina_actual)

    def ver_estado(self):
        print("estas en: " + self.pagina_actual)


def mostrar_menu():
    print("\n===== Menu =====")
    print("1 - Visitar pagina nueva")
    print("2 - Back")
    print("3 - Forward")
    print("4 - Ver pagina actual")
    print("5 - Salir")
    print("================")


def main():
    navegador = NavegadorWeb()

    opciones = {
        "1": lambda: navegador.visitar(input("url: ")),
        "2": navegador.back,
        "3": navegador.forward,
        "4": navegador.ver_estado,
    }

    while True:
        mostrar_menu()

        try:
            op = input("opcion: ").strip()
        except KeyboardInterrupt:
            print("\nsaliendo...")
            break

        if op == "" or op == "5":
            print("saliendo...")
            break

        accion = opciones.get(op)
        if accion:
            accion()
        else:
            print("opcion invalida")


if __name__ == "__main__":
    main()
