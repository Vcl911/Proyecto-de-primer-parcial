pila_atras = []
pila_adelante = []
pagina_actual = "about:blank"
CAPACIDAD_MAXIMA = 4
class NavegadorWeb:

    def __init__(self):
        self.pila_atras = []
        self.pila_adelante = []
        self.pagina_actual = "about:blank"
        self.CAPACIDAD_MAXIMA = 4

    def visitar(self, url):
        # Validacion del tope de 4 elementos en la pila atras
        if len(self.pila_atras) >= self.CAPACIDAD_MAXIMA:
            print("X PILA LLENA")
        else:
            self.pila_atras.append(self.pagina_actual)

        self.pagina_actual = url
        self.pila_adelante.clear()
        print("Visitando: " + self.pagina_actual)

    def back(self):
        if len(self.pila_atras) == 0:
            print("X PILA VACIA")
            return

        # Guardamos la actual en adelante antes de retroceder
        if len(self.pila_adelante) < self.CAPACIDAD_MAXIMA:
            self.pila_adelante.append(self.pagina_actual)

        self.pagina_actual = self.pila_atras.pop()
        print("regresaste a: " + self.pagina_actual)

    def forward(self):
        if len(self.pila_adelante) == 0:
            print("X PILA VACIA")
            return

        # Guardamos la actual en atras antes de avanzar
        if len(self.pila_atras) < self.CAPACIDAD_MAXIMA:
            self.pila_atras.append(self.pagina_actual)

        self.pagina_actual = self.pila_adelante.pop()
        print("avanzaste a: " + self.pagina_actual)

    def ver_estado(self):
        print("estas en: " + self.pagina_actual)


# Instancia del navegador y menú principal
navegador = NavegadorWeb()
op = 0

while op != 5:
    print("")
    print("1 - Visitar pagina nueva")
    print("2 - Back")
    print("3 - Forward")
    print("4 - Ver pagina actual")
    print("5 - Salir")

    try:
        op_input = input("opcion: ").strip()
        if op_input == "":
            print("\nsaliendo...")
            break
        op = int(op_input)
    except (ValueError, KeyboardInterrupt):
        print("opcion invalida")
        continue

    if op == 1:
        u = input("url: ")
        navegador.visitar(u)
    elif op == 2:
        navegador.back()
    elif op == 3:
        navegador.forward()
    elif op == 4:
        navegador.ver_estado()
    elif op == 5:
        print("saliendo...")
    else:
        print("opcion invalida")


